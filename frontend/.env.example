# Public base URL of the Module 2 FastAPI service (no trailing slash needed).
# Read at BUILD time by Vite. There is deliberately no default in the source code.
#
#   Local dev (backend running on your machine):  http://localhost:8000
#   Docker Compose (browser talks to published port): http://localhost:8000
#   Production (Vercel): https://<your-module-2-host>
VITE_API_BASE_URL=http://localhost:8000
